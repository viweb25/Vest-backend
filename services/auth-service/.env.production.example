# ==============================================================================
# VEST SOLUTIONS - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. DO NOT commit this file with real secrets to Git.
# 2. Add these environment variables in your Hosting Dashboard:
#    (e.g., Render -> Environment, Railway -> Variables, AWS ECS -> Task Definition, VPS -> /etc/environment)
# 3. For connection pooling with Supabase/Postgres, use port 6543 with ?pgbouncer=true
# 4. Generate 64-char JWT secrets: `openssl rand -base64 32`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
# Must match your public production domain (HTTPS only, no trailing slash)
FRONTEND_URL="https://vestsolutions.com"

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE CONFIGURATION (Hostzop Ubuntu 24.04 VPS)
# ------------------------------------------------------------------------------
# When app and PostgreSQL both run on the same VPS:
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="vest_db"
DB_USER="vest_user"
DB_PASSWORD="[YOUR_SECURE_VPS_POSTGRESQL_PASSWORD]"

# Connection pool settings for production
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Full connection string for Prisma / Migrations:
DATABASE_URL="postgresql://vest_user:[YOUR_SECURE_VPS_POSTGRESQL_PASSWORD]@127.0.0.1:5432/vest_db"

# ------------------------------------------------------------------------------
# 4. JWT SECURITY & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Generate high-entropy 256-bit keys:
# Linux/macOS/Git Bash: openssl rand -base64 32
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_ACCESS_SECRET="PROD_SUPER_SECURE_RANDOM_ACCESS_SECRET_64_CHARS"
JWT_REFRESH_SECRET="PROD_SUPER_SECURE_RANDOM_REFRESH_SECRET_64_CHARS"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. REDIS CLOUD / CACHING / RATE LIMITING
# ------------------------------------------------------------------------------
# Use TLS-enabled Redis (rediss://) in production:
REDIS_URL="rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:[REDIS_PORT]"

# ------------------------------------------------------------------------------
# 6. SUPABASE STORAGE (BUCKET & ASSET ISOLATION)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 7. PRODUCTION GOOGLE OAUTH
# ------------------------------------------------------------------------------
# In Google Cloud Console, authorize JavaScript origin: https://vestsolutions.com
# and Redirect URI: https://api.vestsolutions.com/api/auth/google/callback
GOOGLE_CLIENT_ID="[PROD_CLIENT_ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[PROD_CLIENT_SECRET]"
GOOGLE_CALLBACK_URL="https://api.vestsolutions.com/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 8. PRODUCTION GITHUB OAUTH
# ------------------------------------------------------------------------------
# In GitHub OAuth Apps, authorize Homepage: https://vestsolutions.com
# and Authorization callback: https://api.vestsolutions.com/api/auth/github/callback
GITHUB_CLIENT_ID="[PROD_GITHUB_CLIENT_ID]"
GITHUB_CLIENT_SECRET="[PROD_GITHUB_CLIENT_SECRET]"
GITHUB_CALLBACK_URL="https://api.vestsolutions.com/api/auth/github/callback"

# ------------------------------------------------------------------------------
# 9. PRODUCTION TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Recommendation: Dedicated corporate SMTP (SendGrid, Amazon SES, Brevo, or Google Workspace)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="notifications@vestsolutions.com"
SMTP_PASSWORD="[16_CHAR_GOOGLE_APP_PASSWORD]"

# ------------------------------------------------------------------------------
# 10. SYSTEM NOTIFICATIONS & TECHNICAL CONSULTATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@vestsolutions.com"
DEFAULT_MEETING_LINK="https://meet.google.com/vest-solutions-consultation"
