# ==============================================================================
# VEST SOLUTIONS - AUTH & BACKEND SERVICE ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets (.env) to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT
# ------------------------------------------------------------------------------
# URL of the VEST Next.js frontend application (no trailing slash)
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION (Hostzop Ubuntu 24.04 VPS)
# ------------------------------------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="vest_db"
DB_USER="vest_user"
DB_PASSWORD="your_database_password_here"

# Connection pool settings (optional)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Full connection string (Prisma / Migration support)
DATABASE_URL="postgresql://vest_user:your_database_password_here@127.0.0.1:5432/vest_db"

# ------------------------------------------------------------------------------
# 4. JWT SECURITY & SESSION AUTHENTICATION
# ------------------------------------------------------------------------------
# Use strong random strings. In production, generate using: openssl rand -base64 32
JWT_ACCESS_SECRET="your_jwt_access_secret_key_minimum_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_characters"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. REDIS CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# Local Docker or hosted Redis (e.g., Upstash / Redis Cloud)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 6. SUPABASE STORAGE & ADMIN SDK
# ------------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0
# ------------------------------------------------------------------------------
# Configure at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 8. GITHUB OAUTH
# ------------------------------------------------------------------------------
# Configure at: https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL & NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="notifications@vestsolutions.com"
SMTP_PASSWORD="your_smtp_app_password"

# ------------------------------------------------------------------------------
# 10. SYSTEM ADMIN & CONSULTATION MEETINGS
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@vestsolutions.com"
DEFAULT_MEETING_LINK="https://meet.google.com/your-default-meeting-room"
